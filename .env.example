# NameMachine — environment variables
# Copy values into Railway → service `web` → Variables.
# Never commit real tokens.

# --- Required for AI generation ---
OPENAI_API_KEY=

# --- Name.com (makes .com status claimable / purchasable after RDAP 404) ---
# Account → Settings → Security → API Tokens
# Docs: https://docs.name.com/guides/authentication
# Production API: https://api.name.com
# IMPORTANT: disable 2FA on the account used for API access (Name.com requirement).
NAMECOM_USERNAME=
NAMECOM_API_TOKEN=

# Optional: sandbox instead of production (use username-test + sandbox token)
# NAMECOM_API_BASE=https://api.dev.name.com

# --- Optional stronger social evidence ---
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# --- Optional Telegram evidence service ---
# TELEGRAM_EVIDENCE_URL=
# TELEGRAM_EVIDENCE_TOKEN=

# --- Runtime tuning ---
# HTTP_TIMEOUT=6
# AVAILABILITY_WORKERS=8
# WEB_CONCURRENCY=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=180
# AI_RATE_LIMIT=5 per minute;30 per hour
# CHECK_RATE_LIMIT=60 per minute
